# =============================================================================
# Cloney v1 - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# App Configuration
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
APP_NAME=Cloney

# -----------------------------------------------------------------------------
# Shopify (from Partner Dashboard: https://partners.shopify.com)
# -----------------------------------------------------------------------------
SHOPIFY_API_KEY=your_client_id
SHOPIFY_API_SECRET=your_client_secret
SHOPIFY_SCOPES=write_themes,read_themes,write_products,read_products

# -----------------------------------------------------------------------------
# Database - PostgreSQL (Choose ONE option)
# -----------------------------------------------------------------------------

# Option 1: Neon (Recommended for production - Free tier available)
# Sign up at https://neon.tech, create a project, copy connection string
# DATABASE_URL=postgresql://username:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# Option 2: Supabase (Free tier available)
# Sign up at https://supabase.com, create project, go to Settings > Database > Connection string
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres

# Option 3: Railway (Simple deploy)
# Sign up at https://railway.app, create PostgreSQL service, copy connection string
# DATABASE_URL=postgresql://postgres:password@containers-us-west-xxx.railway.app:5432/railway

# Option 4: Local PostgreSQL (for development)
# Install PostgreSQL from https://www.postgresql.org/download/windows/
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cloney_db

# Option 5: Docker PostgreSQL (for development)
# Run: docker run --name cloney-postgres -e POSTGRES_PASSWORD=mysecretpassword -e POSTGRES_DB=cloney_db -p 5432:5432 -d postgres:16
# DATABASE_URL=postgresql://postgres:mysecretpassword@localhost:5432/cloney_db

# Active database URL (uncomment and configure one of the above)
DATABASE_URL=postgresql://postgres:password@localhost:5432/cloney_db

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Generate a random 32+ character string for encrypting access tokens
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-character-secret-key-here

# -----------------------------------------------------------------------------
# Billing & Limits (Development Settings)
# -----------------------------------------------------------------------------
# Set to 'true' to enforce generation limits (disabled by default for development)
ENFORCE_GENERATION_LIMIT=false

# Set to 'true' to bypass paid plan requirement for imports (for testing)
BYPASS_BILLING=true

# -----------------------------------------------------------------------------
# Cloudflare R2 Storage (for product image uploads)
# -----------------------------------------------------------------------------
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
# 1. Create an R2 bucket (e.g., "cloney-images")
# 2. Enable public access on the bucket and note the public URL
# 3. Create an API token with Object Read & Write permissions

R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=cloney-images
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
